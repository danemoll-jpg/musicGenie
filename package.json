{
  "name": "musicgenie",
  "productName": "musicGenie",
  "version": "0.8.0",
  "description": "Desktop music studio: import, arrange, play, and (later) export to Rocksmith 2014",
  "author": "Dan Moll",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win dir",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:dev": "node tests/e2e/run.mjs --dev",
    "e2e:r2": "node tests/e2e/round2.mjs",
    "e2e:r2:dev": "node tests/e2e/round2.mjs --dev",
    "helper": "dotnet publish helpers/rocksmith/MgRocksmith/MgRocksmith.fsproj -c Release -o helpers/rocksmith/bin --nologo -v q -p:NuGetAudit=false",
    "e2e:r3": "node tests/e2e/round3.mjs",
    "e2e:r3:dev": "node tests/e2e/round3.mjs --dev",
    "e2e:r4": "node tests/e2e/round4.mjs",
    "e2e:r4:dev": "node tests/e2e/round4.mjs --dev",
    "e2e:r5": "node tests/e2e/round5.mjs",
    "e2e:r5:dev": "node tests/e2e/round5.mjs --dev",
    "e2e:r6": "node tests/e2e/round6.mjs",
    "e2e:r6:dev": "node tests/e2e/round6.mjs --dev",
    "e2e:r7": "node tests/e2e/round7.mjs",
    "e2e:r7:dev": "node tests/e2e/round7.mjs --dev",
    "e2e:r8": "node tests/e2e/round8.mjs",
    "e2e:r8:dev": "node tests/e2e/round8.mjs --dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@breezystack/lamejs": "1.2.7",
    "@coderline/alphatab": "1.9.0",
    "@tonejs/midi": "2.0.28",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.danmoll.musicgenie",
    "productName": "musicGenie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "musicGenie-${version}-portable.exe"
    },
    "extraResources": [
      {
        "from": "helpers/rocksmith/bin",
        "to": "rocksmith",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  }
}
